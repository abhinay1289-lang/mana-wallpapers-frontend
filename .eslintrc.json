{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:react/recommended",
        "prettier"
    ],
    "overrides": [
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "plugins": [
        "react",
        "react-hooks",
        "prettier"
    ],
    "rules": {
        "react/jsx-filename-extension": [ "warn", {"extensions": [".js", ".jsx"]} ],
        "react/react-in-jsx-scope": "off",
        "camelcase": "error",
        "quotes": ["error", "single"],
        "no-duplicate-imports": "error"
    },
    "settings": {
        "react": {
            "version": "detect"
        }
    }
}